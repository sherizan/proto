{
  "name": "proto-components",
  "version": "0.0.0",
  "private": true,
  "description": "Proto React Native component library — Screen, Stack, Text, Card, Button, Toggle, Modal, Picker, DatePicker, Menu, Alert, Divider, plus motion / gestures / lottie / canvas / svg subpaths",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./motion": "./src/motion/index.tsx",
    "./gestures": "./src/gestures/index.ts",
    "./lottie": "./src/lottie/index.tsx",
    "./canvas": "./src/canvas/index.ts",
    "./svg": "./src/svg/index.ts"
  },
  "types": "./src/index.ts",
  "files": ["src"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@expo/ui": "*",
    "@shopify/react-native-skia": "*",
    "expo-glass-effect": "*",
    "expo-haptics": "*",
    "expo-linear-gradient": "*",
    "lottie-react-native": "*",
    "react": "*",
    "react-native": "*",
    "react-native-ease": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*",
    "react-native-screens": "*"
  },
  "devDependencies": {
    "@expo/ui": "58.0.21",
    "@shopify/react-native-skia": "2.14.0",
    "@types/react": "~19.3.0",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.3",
    "expo-linear-gradient": "~58.0.2",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ease": "^0.7.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
