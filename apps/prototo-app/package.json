{
  "name": "prototo-app",
  "version": "0.2.5",
  "private": true,
  "description": "Prototo — custom Expo dev client. Designer canvas for proto start on Simulator and iPhone. Renders real iOS 26 Liquid Glass.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "test": "vitest run --passWithNoTests",
    "build:ios": "eas build --platform ios --profile development",
    "build:ios:sim": "eas build --platform ios --profile development-simulator",
    "build:ios:prod": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "release:simulator": "tsx scripts/release-simulator.ts",
    "release:all": "pnpm build:ios && pnpm build:ios:sim && pnpm release:simulator"
  },
  "dependencies": {
    "@expo/ui": "58.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~58.0.16",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-iap": "~5.6.3",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.18",
    "expo-maps": "~58.0.10",
    "expo-router": "~58.0.24",
    "expo-screen-orientation": "~58.0.3",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-updates": "~58.0.17",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "lottie-react-native": "~7.5.0",
    "proto-components": "workspace:*",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ease": "^0.7.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/cli": "^58.0.0",
    "@types/node": "^22.12.0",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^2.1.4",
    "babel-preset-expo": "~58.0.18",
    "tsx": "^4.15.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.4"
  }
}
