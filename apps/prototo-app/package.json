{
  "name": "prototo-app",
  "version": "0.2.5",
  "private": true,
  "description": "Prototo — custom Expo dev client. Designer canvas for proto start on Simulator and iPhone. Renders real iOS 26 Liquid Glass.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "test": "vitest run --passWithNoTests",
    "build:ios": "eas build --platform ios --profile development",
    "build:ios:sim": "eas build --platform ios --profile development-simulator",
    "build:ios:prod": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "release:simulator": "tsx scripts/release-simulator.ts",
    "release:all": "pnpm build:ios && pnpm build:ios:sim && pnpm release:simulator"
  },
  "dependencies": {
    "@expo/ui": "57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~57.0.23",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-iap": "~5.6.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.18",
    "expo-maps": "~57.0.3",
    "expo-router": "~57.0.21",
    "expo-screen-orientation": "~57.0.2",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-updates": "~57.0.22",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lottie-react-native": "~7.3.4",
    "proto-components": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ease": "^0.7.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/cli": "^57.0.0",
    "@expo/config-plugins": "57.0.9",
    "@types/node": "^20.12.0",
    "@types/react": "~19.2.15",
    "@vitest/coverage-v8": "^2.1.4",
    "babel-preset-expo": "~57.0.12",
    "tsx": "^4.15.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.4"
  }
}
